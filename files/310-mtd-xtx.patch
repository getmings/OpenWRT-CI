From: Leo <62428370+LeoooChen@users.noreply.github.com>
Subject: [PATCH] mtd: spi-nand: add the XT26G02C device

The PT1500 board carries a 256 MiB XTX XT26G02C. It uses the
XT26xxxD OOB layout but has its own ECC status encoding.

Signed-off-by: Leo <62428370+LeoooChen@users.noreply.github.com>
 drivers/mtd/nand/spi/xtx.c | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/drivers/mtd/nand/spi/xtx.c b/drivers/mtd/nand/spi/xtx.c
index 5915b37b4..13a73b06f 100644
--- a/drivers/mtd/nand/spi/xtx.c
+++ b/drivers/mtd/nand/spi/xtx.c
@@ -138,6 +138,22 @@ static int xt26xxxd_ecc_get_status(struct spinand_device *spinand,
 
 	return -EINVAL;
 }
+
+// XT26G02C ECC
+static int xt26g0xc_ecc_get_status(struct spinand_device *spinand,
+                                   u8 status)
+{
+    u8 ecc_status = FIELD_GET(GENMASK(7, 4), status);
+
+    if (ecc_status == 0xF)
+        return -EBADMSG;
+
+    if (ecc_status <= 8)
+        return ecc_status;
+
+    return -EINVAL;
+}
+
 static const struct spinand_info xtx_spinand_table[] = {
 	SPINAND_INFO("XT26G01A",
 		     SPINAND_ID(SPINAND_READID_METHOD_OPCODE_ADDR, 0xE1),
@@ -209,6 +225,16 @@ static const struct spinand_info xtx_spinand_table[] = {
 		     0,
 		     SPINAND_ECCINFO(&xt26xxxd_ooblayout,
 				     xt26xxxd_ecc_get_status)),
+	SPINAND_INFO("XT26G02C",
+		     SPINAND_ID(SPINAND_READID_METHOD_OPCODE_ADDR, 0x12),
+		     NAND_MEMORG(1, 2048, 128, 64, 2048, 40, 1, 1, 1),
+		     NAND_ECCREQ(8, 512),
+		     SPINAND_INFO_OP_VARIANTS(&read_cache_variants,
+					      &write_cache_variants,
+					      &update_cache_variants),
+		     0,
+		     SPINAND_ECCINFO(&xt26xxxd_ooblayout,
+				     xt26g0xc_ecc_get_status)),
 	SPINAND_INFO("XT26G12D",
 		     SPINAND_ID(SPINAND_READID_METHOD_OPCODE_ADDR, 0x35),
 		     NAND_MEMORG(1, 2048, 128, 64, 2048, 40, 1, 1, 1),
-- 
2.55.0

